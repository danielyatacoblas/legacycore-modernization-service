[Unit]
Description=LegacyCore modernization service
After=network-online.target
Wants=network-online.target

[Service]
User=legacycore
Group=legacycore
EnvironmentFile=/etc/legacycore/legacycore.env
ExecStart=/usr/bin/java -XX:MaxRAMPercentage=75 -jar /opt/legacycore/legacycore.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
